# TierScape Daemon Configuration
# Two-tier byte-addressable memory tiering

[tiers]
hot_node = 0
cold_node = 1

[sampling]
# PEBS events. Symbolic names (validated via `perf list`) are
# preferred and match the built-in defaults; raw hex form
# (e.g. "cpu/event=0xd0,umask=0x81/ppu") also works on Intel CPUs
# when the symbolic name is unavailable.
events = [
    "mem_inst_retired.all_loads:P",
    "mem_inst_retired.all_stores:P",
]
frequency = 10000
window_seconds = 20

[classification]
# Regions at or above this percentile of hotness → hot tier
hot_percentile = 25.0

[migration]
threads = 2
max_pages_per_window = 5000000
region_size = "2M"

[daemon]
pidfile = "/tmp/tierscaped.pid"
verbose = false
log_file = ""
perf_bin = "/usr/bin/perf"
